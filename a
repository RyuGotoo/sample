# Convert-DocsToMarkdown.ps1
# Usage: .\Convert-DocsToMarkdown.ps1 -DirPath "C:\path\to\docs"

param (
    [Parameter(Mandatory = $true)]
    [string]$DirPath
)

# ===== 設定 =====
$PandocExe = "C:\path\to\pandoc.exe"
# ================

if (-not (Test-Path $DirPath -PathType Container)) {
    Write-Error "ディレクトリが見つかりません: $DirPath"
    exit 1
}

if (-not (Test-Path $PandocExe)) {
    Write-Error "pandoc.exe が見つかりません: $PandocExe"
    exit 1
}

# 出力ディレクトリ: 元ディレクトリ名_md
$DirPath = $DirPath.TrimEnd('\', '/')
$OutDir = $DirPath + "_md"
if (-not (Test-Path $OutDir)) {
    New-Item -ItemType Directory -Path $OutDir | Out-Null
}

# Word COM オブジェクト初期化
$Word = New-Object -ComObject Word.Application
$Word.Visible = $false

try {
    # .doc と .docx を再帰的に取得
    $Files = Get-ChildItem -Path $DirPath -Recurse -Include "*.doc", "*.docx"

    foreach ($File in $Files) {
        $DocxPath = $null
        $CreatedDocx = $false

        if ($File.Extension -eq ".doc") {
            # .doc → .docx 変換
            $DocxPath = [System.IO.Path]::ChangeExtension($File.FullName, ".docx")
            Write-Host "[doc→docx] $($File.FullName)"

            $Doc = $Word.Documents.Open($File.FullName)
            # 16 = wdFormatXMLDocument (docx)
            $Doc.SaveAs([ref]$DocxPath, [ref]16)
            $Doc.Close()
            $CreatedDocx = $true
        } else {
            # すでに .docx
            $DocxPath = $File.FullName
        }

        # .docx → Markdown (GFM)
        # 元ディレクトリからの相対パスを保持して出力先を決定
        $RelPath = [System.IO.Path]::GetRelativePath($DirPath, $DocxPath)
        $MdRelPath = [System.IO.Path]::ChangeExtension($RelPath, ".md")
        $MdPath = Join-Path $OutDir $MdRelPath
        # 出力先サブディレクトリが存在しない場合は作成
        $MdDir = Split-Path $MdPath -Parent
        if (-not (Test-Path $MdDir)) {
            New-Item -ItemType Directory -Path $MdDir | Out-Null
        }
        Write-Host "[docx→md] $DocxPath"

        & $PandocExe $DocxPath -f docx -t gfm -o $MdPath

        if ($LASTEXITCODE -ne 0) {
            Write-Warning "pandoc 変換失敗: $DocxPath"
        }

        # 中間生成した .docx は削除
        if ($CreatedDocx) {
            Remove-Item $DocxPath
        }
    }
} finally {
    $Word.Quit()
    [System.Runtime.InteropServices.Marshal]::ReleaseComObject($Word) | Out-Null
}

Write-Host "完了"
